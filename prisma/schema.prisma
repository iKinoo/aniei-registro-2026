generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accesos {
  id_acceso  Int       @id @default(autoincrement())
  id_usuario Int?
  email      String    @unique @db.VarChar(100)
  rol        String?   @default("USER") @db.VarChar(20)
  nombre     String?   @db.VarChar(150)
  auth_id    String?   @unique @db.Uuid
  password   String?   @db.VarChar(255)
  usuarios   usuarios? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
}

model actividad_ponentes {
  id_actividad       Int
  id_usuario_ponente Int
  rol                String?     @db.VarChar(50)
  url_constancia     String?
  actividades        actividades @relation(fields: [id_actividad], references: [id_actividad], onDelete: Cascade, onUpdate: NoAction)
  usuarios           usuarios    @relation(fields: [id_usuario_ponente], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_actividad, id_usuario_ponente])
}

model actividades {
  id_actividad             Int                       @id @default(autoincrement())
  nombre                   String                    @db.VarChar(200)
  descripcion              String?
  cupo_maximo              Int?                      @default(0)
  fecha_inicio             DateTime                  @db.Timestamp(6)
  fecha_fin                DateTime                  @db.Timestamp(6)
  id_tipo_actividad        Int?
  id_institucion_sede      Int?
  id_sala                  Int?                      @default(0)
  actividad_costo          actividad_costo?
  actividad_ponentes       actividad_ponentes[]
  instituciones            instituciones?            @relation(fields: [id_institucion_sede], references: [id_institucion], onUpdate: NoAction)
  tipo_actividad           tipo_actividad?           @relation(fields: [id_tipo_actividad], references: [id_tipo_actividad], onDelete: Restrict, onUpdate: NoAction)
  asistencia_actividades   asistencia_actividades[]
  equipos                  equipos[]
  inscripcion_actividades  inscripcion_actividades[]
}

model actividad_costo {
  id_actividad Int         @id
  folio_recibo String?     @db.VarChar(50)
  monto        Decimal     @db.Decimal(10, 2)
  actividades  actividades @relation(fields: [id_actividad], references: [id_actividad], onDelete: Cascade, onUpdate: NoAction)
}

model asistencia_actividades {
  id_asistencia      Int          @id @default(autoincrement())
  id_usuario         Int?
  id_actividad       Int?
  fecha_hora_marcaje DateTime?    @default(now()) @db.Timestamp(6)
  actividades        actividades? @relation(fields: [id_actividad], references: [id_actividad], onDelete: Cascade, onUpdate: NoAction)
  usuarios           usuarios?    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_usuario, id_actividad])
}

model cargos {
  id_cargo    Int        @id @default(autoincrement())
  descripcion String     @db.VarChar(50)
  usuarios    usuarios[]
}

model depositos {
  id_deposito     Int       @id @default(autoincrement())
  id_usuario      Int?
  banco_sucursal  String?   @db.VarChar(100)
  ciudad          String?   @db.VarChar(100)
  referencia      String    @db.VarChar(50)
  monto           Decimal   @db.Decimal(10, 2)
  fecha_deposito  DateTime  @db.Timestamp(6)
  fecha_registro  DateTime? @default(now()) @db.Timestamp(6)
  archivo_url     String    @db.VarChar(500)
  archivo_nombre  String    @db.VarChar(255)
  archivo_mime    String    @db.VarChar(100)
  archivo_tamanio Int
  usuarios        usuarios? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
}

model equipo_integrantes {
  id_integrante    Int      @id @default(autoincrement())
  id_equipo        Int
  id_usuario       Int
  es_representante Boolean? @default(false)
  equipos          equipos  @relation(fields: [id_equipo], references: [id_equipo], onDelete: Cascade, onUpdate: NoAction)
  usuarios         usuarios @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)
}

model equipos {
  id_equipo          Int                  @id @default(autoincrement())
  id_actividad       Int
  id_institucion     Int?
  nombre_equipo      String               @db.VarChar(150)
  fecha_registro     DateTime?            @default(now()) @db.Timestamp(6)
  equipo_integrantes equipo_integrantes[]
  actividades        actividades          @relation(fields: [id_actividad], references: [id_actividad], onUpdate: NoAction)
  instituciones      instituciones?       @relation(fields: [id_institucion], references: [id_institucion], onUpdate: NoAction)
}

model estados {
  id_entidad_federativa Int             @id @default(autoincrement())
  nombre                String          @db.VarChar(50)
  facturaciones         facturaciones[]
  usuarios              usuarios[]
}

model facturaciones {
  id_facturacion            Int       @id @default(autoincrement())
  id_usuario                Int?
  razon_social              String    @db.VarChar(150)
  rfc                       String    @db.VarChar(20)
  calle                     String?   @db.VarChar(100)
  num_exterior              String?   @db.VarChar(20)
  num_interior              String?   @db.VarChar(20)
  colonia                   String?   @db.VarChar(100)
  municipio                 String?   @db.VarChar(100)
  codigo_postal             String?   @db.VarChar(10)
  id_entidad_federativa_rfc Int?
  estados                   estados?  @relation(fields: [id_entidad_federativa_rfc], references: [id_entidad_federativa], onUpdate: NoAction)
  usuarios                  usuarios? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
}

model inscripcion_actividades {
  id_inscripcion    Int          @id @default(autoincrement())
  id_usuario        Int?
  id_actividad      Int?
  fecha_inscripcion DateTime?    @default(now()) @db.Timestamp(6)
  url_constancia    String?      @db.VarChar(500)
  actividades       actividades? @relation(fields: [id_actividad], references: [id_actividad], onDelete: Cascade, onUpdate: NoAction)
  usuarios          usuarios?    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_usuario, id_actividad])
}

model instituciones {
  id_institucion Int           @id @default(autoincrement())
  nombre         String        @db.VarChar(150)
  abreviatura    String?       @db.VarChar(30)
  actividades    actividades[]
  equipos        equipos[]
  talleres       talleres[]
  usuarios       usuarios[]
}

model talleres {
  id_taller              Int            @id @default(autoincrement())
  nombre_taller          String         @db.VarChar(150)
  cupo_maximo            Int?           @default(0)
  horario_texto          String?        @db.VarChar(50)
  dias_semana            String?        @db.VarChar(50)
  id_institucion_imparte Int?
  instituciones          instituciones? @relation(fields: [id_institucion_imparte], references: [id_institucion], onUpdate: NoAction)
}

model tipo_actividad {
  id_tipo_actividad                Int           @id @default(autoincrement())
  descripcion                      String        @db.VarChar(50)
  clave                            String?       @db.VarChar(50)
  maneja_equipos                   Boolean?      @default(false)
  genera_constancia_participante   Boolean?      @default(false)
  actividades                      actividades[]
}

model tipo_usuario {
  id_tipo_usuario Int        @id @default(autoincrement())
  descripcion     String     @db.VarChar(50)
  usuarios        usuarios[]
}

model titulos {
  id_titulo   Int    @id @default(autoincrement())
  descripcion String @db.VarChar(50)
}

model usuarios {
  id_usuario              Int                       @id @default(autoincrement())
  folio_recibo            String?                   @unique @db.VarChar(15)
  codigo_barras           String?                   @unique @db.VarChar(50)
  nombre                  String                    @db.VarChar(125)
  apellido                String                    @db.VarChar(256)
  correo                  String                    @unique @db.VarChar(100)
  telefono                String?                   @db.VarChar(20)
  lada                    String?                   @db.VarChar(10)
  extension               String?                   @db.VarChar(10)
  genero                  String?                   @db.Char(1)
  carrera                 String?                   @db.VarChar(128)
  dependencia             String?                   @db.VarChar(128)
  id_cargo                Int?
  id_tipo_usuario         Int?
  id_institucion          Int?
  id_entidad_federativa   Int?
  verificado              Boolean?                  @default(false)
  fecha_registro          DateTime?                 @default(now()) @db.Timestamp(6)
  id_grupo_registro       Int?
  accesos                 accesos[]
  actividad_ponentes      actividad_ponentes[]
  asistencia_actividades  asistencia_actividades[]
  depositos               depositos[]
  equipo_integrantes      equipo_integrantes[]
  facturaciones           facturaciones[]
  grupos_liderados        grupos_registro[]         @relation("GrupoResponsable")
  inscripcion_actividades inscripcion_actividades[]
  cargos                  cargos?                   @relation(fields: [id_cargo], references: [id_cargo], onUpdate: NoAction)
  estados                 estados?                  @relation(fields: [id_entidad_federativa], references: [id_entidad_federativa], onUpdate: NoAction)
  grupo_registro          grupos_registro?          @relation("GrupoMiembros", fields: [id_grupo_registro], references: [id])
  instituciones           instituciones?            @relation(fields: [id_institucion], references: [id_institucion], onUpdate: NoAction)
  tipo_usuario            tipo_usuario?             @relation(fields: [id_tipo_usuario], references: [id_tipo_usuario], onUpdate: NoAction)
}

model grupos_registro {
  id             Int        @id @default(autoincrement())
  token          String     @unique @db.VarChar(100)
  id_responsable Int
  fecha_registro DateTime   @default(now()) @db.Timestamp(6)
  responsable    usuarios   @relation("GrupoResponsable", fields: [id_responsable], references: [id_usuario], onDelete: Cascade)
  miembros       usuarios[] @relation("GrupoMiembros")
}
