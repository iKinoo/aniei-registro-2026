# Ejemplo de configuración local — PostgreSQL nativo + filesystem del proyecto.
# Copiar a .env.local y rellenar secretos. No commitear .env.local.
# Postgres SOLO datos relacionales. Archivos en ./storage (filesystem, sin S3 ni Docker).

DATABASE_URL="postgresql://aniei:cambia-esta-clave@localhost:5432/aniei"
DIRECT_URL="postgresql://aniei:cambia-esta-clave@localhost:5432/aniei"

STORAGE_PROVIDER="filesystem"
STORAGE_LOCAL_DIR="./storage"
STORAGE_URL_SECRET="cambia-esto-por-32-caracteres-minimo"
FILE_URL_TTL_SECONDS="300"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="genera-con-openssl-rand-base64-32"

GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM=""

# Legacy Supabase — solo transición (script de extracción). No requerido en local.
# NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="[REDACTED]"
